# Copy to `.env` for local dev. NEVER commit `.env`.
# Production values live in `/etc/azureus/.env.production` on the droplet (chmod 600).

# === Postgres ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=azureus
POSTGRES_USER=azureus
POSTGRES_PASSWORD=changeme
# Async URL used by the FastAPI app
DATABASE_URL=postgresql+asyncpg://azureus:changeme@postgres:5432/azureus
# Sync URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://azureus:changeme@postgres:5432/azureus

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === Application ===
APP_ENV=local
APP_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
LOG_LEVEL=INFO

# === Admin (HTTP Basic Auth at Caddy in prod) ===
ADMIN_USERNAME=admin
# Generate with: caddy hash-password --plaintext 'yourpassword'
ADMIN_PASSWORD_HASH=

# === Data provider switch ===
# `yfinance` (deployed) or `bloomberg` (local research only)
DATA_PROVIDER=yfinance

# === MLflow ===
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/var/azureus/mlflow_artifacts

# === Prefect ===
PREFECT_API_URL=http://prefect:4200/api

# === Build-time (populated by CI/CD; safe to leave blank locally) ===
GIT_SHA=
BUILD_TIME=
