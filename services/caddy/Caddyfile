{$AZUREUS_SITE_ADDRESS::80} {
	root * /srv/frontend
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

{$MLFLOW_SITE_ADDRESS:mlflow.azureus.tech} {
	encode zstd gzip

	basic_auth {
		{$MLFLOW_BASIC_AUTH_USER:admin} {$MLFLOW_BASIC_AUTH_HASH}
	}

	reverse_proxy mlflow:5000
}
